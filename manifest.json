{
  "id": "./",
  "name": "MD Reader",
  "short_name": "MD Reader",
  "description": "Leitor Markdown privado, acessível e offline.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#fffaf8",
  "theme_color": "#fffaf8",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/markdown": [
          ".md",
          ".markdown",
          ".mdown",
          ".mkd"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Minhas Bibliotecas",
      "short_name": "Bibliotecas",
      "description": "Abrir suas coleções de Markdown",
      "url": "./?view=libraries",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Abrir Markdown",
      "short_name": "Abrir arquivo",
      "description": "Selecionar um arquivo Markdown do dispositivo",
      "url": "./?view=open",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Marcadores",
      "short_name": "Marcadores",
      "description": "Consultar trechos marcados",
      "url": "./?view=marks",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
